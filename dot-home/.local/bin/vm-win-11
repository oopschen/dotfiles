#!/usr/bin/env bash
# 用法:
#   DISPLAY_MODE=gtk|lg|none  DISK_IF=sata|virtio  MEM_SIZE=4G  ./vm-new.sh [额外qemu参数]
#   gtk  : GTK窗口(virtio-vga) + 直通GPU(原行为)
#   lg   : Looking Glass(GPU渲染 -> 宿主窗口) + SPICE剪贴板/输入, 推荐
#   none : 显示器接在直通显卡上, 宿主不显示
# 托盘(polybar internal/tray, XEmbed):
#   TRAY=1|0                 是否启用托盘图标(默认 1)
#   TRAY_ICON=/path/a.png    图标文件路径, 也可写主题图标名(如 computer); 不存在则回退到 computer
#   TRAY_ICON_PAUSED=/path/b.png  暂停时的图标(可选, 默认同 TRAY_ICON)
set -u

basedir=/home/work/vm/win11
diskdir=$(realpath "$basedir/win11_202307.qcow2")
diskdata=$(realpath "$basedir/win11_202410_data.qcow2")
mem_size=${MEM_SIZE:-4G}
DISPLAY_MODE=${DISPLAY_MODE:-gtk}
DISK_IF=${DISK_IF:-sata}            # 装好 virtio 驱动(viostor/vioscsi)后改成 virtio
GPU=${GPU:-0000:01:00}              # .0 = GPU, .1 = HDMI 音频
LG_SHM_SIZE=${LG_SHM_SIZE:-64M}     # 1080p=32M 1440p=64M 4K=128M
pidfile=/tmp/.vm.win11.pid
prefix_name=vm-qemu-w11
cmd_notify="notify-send -u normal VM($prefix_name) -t 2000"
TRAY=${TRAY:-1}
TRAY_ICON=${TRAY_ICON:-$HOME/.local/share/icons/hicolor/scalable/apps/windows.svg}
TRAY_ICON_PAUSED=${TRAY_ICON_PAUSED:-$HOME/.local/share/icons/hicolor/scalable/apps/windows-paused.svg}
tray_pid=""

# ---------- 防重复启动(检查进程是否真的存活) ----------
if [[ -f $pidfile ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    echo "VM 已在运行, PID $(cat "$pidfile")"; exit 1
fi
rm -f "$pidfile"

# ---------- 固定工作目录(避免 ~/.cache 下随机目录堆积) ----------
workingdir=$HOME/.cache/vm/win11/run
rm -rf "$workingdir"; mkdir -p "$workingdir"
virtiofsd_dir_base=$workingdir/fsmounts
mkdir -p "$virtiofsd_dir_base"/{host-doc,host-app,host-temp}
log_dir=$workingdir/logs; mkdir -p "$log_dir"
virtiofsd_sock_path=$workingdir/virtiofsd.sock
ln -sfn "$workingdir" "/tmp/$prefix_name.current"

# ---------- userns 内 bind mount ----------
setup_file=$workingdir/env-setup.sh
cat > "$setup_file" << EOF
#!/usr/bin/env bash
m() { findmnt -rn "\$2" >/dev/null || mount "\$@"; }
m -o bind,ro "$HOME/Documents"              "$virtiofsd_dir_base/host-doc"
m -o bind    "$HOME/Documents/40appData"    "$virtiofsd_dir_base/host-app"
m -o bind    "$HOME/Downloads/01TempFS"     "$virtiofsd_dir_base/host-temp"
EOF
echo "Mounting shares."
for i in 1 2 3 4 5; do
    podman unshare sh "$setup_file" 2>/dev/null
    [[ $(podman unshare findmnt -rn -R "$virtiofsd_dir_base" | grep -c host-) -ge 3 ]] && break
    sleep 1
done

# ---------- virtiofsd ----------
echo "Starting virtiofsd."
nohup podman unshare /usr/libexec/virtiofsd \
    --socket-path="$virtiofsd_sock_path" \
    --shared-dir "$virtiofsd_dir_base" \
    --announce-submounts --sandbox chroot \
    --cache=auto \
    > "$log_dir/virtiofsd.log" 2>&1 &
vfsd_pid=$!
for i in $(seq 1 15); do [[ -S $virtiofsd_sock_path ]] && break; sleep 1; done
[[ -S $virtiofsd_sock_path ]] || { echo "virtiofsd 启动失败, 见 $log_dir/virtiofsd.log"; exit 1; }

cleanup() {
    for d in "$virtiofsd_dir_base"/host-*; do podman unshare umount "$d" 2>/dev/null; done
    kill "$vfsd_pid" 2>/dev/null   # 通常 qemu 退出后 virtiofsd 自己会退出
    [[ -n $tray_pid ]] && kill "$tray_pid" 2>/dev/null
    [[ -n ${NOTIFY_SND:-} ]] && $cmd_notify "VM Quit."
}
trap cleanup EXIT

# ---------- 自动计算 CPU 拓扑与绑核 ----------
# GUEST_CORES: 分给客户机的物理核数(取编号最大的 N 个核, 整核分配, 保留 core0 给宿主)
GUEST_CORES=${GUEST_CORES:-2}
declare -A core_cpus
core_order=()
while IFS=, read -r core cpu; do
    [[ -z ${core_cpus[$core]:-} ]] && core_order+=("$core")
    core_cpus[$core]+="$cpu "
done < <(lscpu -p=CORE,CPU | grep -v '^#' | sort -t, -k1,1n -k2,2n)

total_cores=${#core_order[@]}
if (( GUEST_CORES < 1 || GUEST_CORES >= total_cores )); then
    echo "GUEST_CORES 必须在 1..$((total_cores-1)) 之间(宿主共 $total_cores 个物理核)"; exit 1
fi
vcpu_map=(); host_list=()
for idx in "${!core_order[@]}"; do
    c=${core_order[$idx]}
    if (( idx >= total_cores - GUEST_CORES )); then
        vcpu_map+=(${core_cpus[$c]})     # 同核线程相邻: vCPU0/1 同核, vCPU2/3 同核 ...
    else
        host_list+=(${core_cpus[$c]})
    fi
done
threads_per_core=$(wc -w <<< "${core_cpus[${core_order[0]}]}")
host_cpus_qemu=$(IFS=,; echo "${host_list[*]}")   # emulator / iothread 等非 vCPU 线程
smp_args="${#vcpu_map[@]},sockets=1,cores=$GUEST_CORES,threads=$threads_per_core"
echo "CPU 拓扑: -smp $smp_args"
echo "vCPU -> 宿主线程: ${vcpu_map[*]} ; 宿主/emulator: $host_cpus_qemu"

# ---------- 托盘图标(XEmbed, 供 polybar internal/tray 识别) ----------
tray_py=$workingdir/tray.py
cat > "$tray_py" << 'PYEOF'
#!/usr/bin/env python3
import json
import os
import signal
import socket

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk

SOCK = os.environ["TRAY_QMP_SOCK"]
QPID = int(os.environ["TRAY_QEMU_PID"])
TITLE = os.environ.get("TRAY_TITLE", "VM")
ICON = os.environ.get("TRAY_ICON", "")
ICON_PAUSED = os.environ.get("TRAY_ICON_PAUSED", "") or ICON
FALLBACK_ICON = "computer"
LABELS = {"running": "运行中", "paused": "已暂停", "unknown": "未知"}


def qmp(command, arguments=None, timeout=3):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(timeout)
        s.connect(SOCK)
        f = s.makefile("rw", buffering=1, encoding="utf-8")
        f.readline()  # greeting

        def call(name, args=None):
            msg = {"execute": name}
            if args:
                msg["arguments"] = args
            f.write(json.dumps(msg) + "\n")
            f.flush()
            while True:
                line = f.readline()
                if not line:
                    raise RuntimeError("connection closed")
                resp = json.loads(line)
                if "event" in resp:
                    continue
                if "error" in resp:
                    raise RuntimeError(resp["error"]["desc"])
                return resp["return"]

        call("qmp_capabilities")
        return call(command, arguments)


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


class Tray:
    def __init__(self):
        self.status = None
        self.icon = Gtk.StatusIcon()
        self.icon.set_title(TITLE)
        self.icon.connect("popup-menu", lambda *_: self.menu.popup_at_pointer(None))
        self.icon.connect("activate", lambda *_: self.menu.popup_at_pointer(None))

        self.menu = Gtk.Menu()
        self.item_status = Gtk.MenuItem(label=TITLE)
        self.item_status.set_sensitive(False)
        self.item_toggle = Gtk.MenuItem(label="暂停")
        self.item_toggle.connect("activate", self.on_toggle)
        item_powerdown = Gtk.MenuItem(label="ACPI 关机")
        item_powerdown.connect("activate", lambda *_: self.run("system_powerdown"))
        item_quit = Gtk.MenuItem(label="强制退出…")
        item_quit.connect("activate", self.on_force_quit)
        for it in (self.item_status, Gtk.SeparatorMenuItem(), self.item_toggle,
                   item_powerdown, Gtk.SeparatorMenuItem(), item_quit):
            self.menu.append(it)
        self.menu.show_all()

        self.apply_icon(ICON)
        self.icon.set_visible(True)
        self.refresh()
        GLib.timeout_add_seconds(3, self.refresh)

    def apply_icon(self, icon):
        # 路径存在 -> 当文件; 否则当作主题图标名; 都没有 -> 回退图标
        if icon and os.path.isfile(icon):
            self.icon.set_from_file(icon)
        else:
            self.icon.set_from_icon_name(icon or FALLBACK_ICON)

    def run(self, command):
        try:
            qmp(command)
        except Exception:
            pass
        self.refresh()

    def on_toggle(self, *_):
        self.run("cont" if self.status == "paused" else "stop")

    def on_force_quit(self, *_):
        dlg = Gtk.MessageDialog(message_type=Gtk.MessageType.WARNING,
                                buttons=Gtk.ButtonsType.YES_NO,
                                text="强制退出虚拟机?")
        dlg.format_secondary_text("相当于直接断电, 客户机内未保存的数据会丢失。")
        ok = dlg.run() == Gtk.ResponseType.YES
        dlg.destroy()
        if ok:
            self.run("quit")

    def refresh(self):
        if not pid_alive(QPID):
            Gtk.main_quit()
            return False
        try:
            st = qmp("query-status")["status"]
        except Exception:
            st = "unknown"
        if st != self.status:
            self.status = st
            text = LABELS.get(st, st)
            self.icon.set_tooltip_text(f"{TITLE}: {text}")
            self.item_status.set_label(f"{TITLE}: {text}")
            self.item_toggle.set_label("恢复" if st == "paused" else "暂停")
            self.apply_icon(ICON_PAUSED if st == "paused" else ICON)
        return True


if __name__ == "__main__":
    Tray()
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, Gtk.main_quit)
    Gtk.main()
PYEOF

start_tray() {
    [[ $TRAY == 1 ]] || return 0
    if [[ -z ${DISPLAY:-} ]]; then echo "TRAY: 没有 DISPLAY, 跳过托盘"; return 0; fi
    if ! python3 -c 'import gi; gi.require_version("Gtk","3.0"); from gi.repository import Gtk' 2>/dev/null; then
        echo "TRAY: python 缺少 PyGObject/GTK3, 跳过托盘"; return 0
    fi
    TRAY_QMP_SOCK="$workingdir/qmp-tray.sock" TRAY_QEMU_PID="$qpid" \
    TRAY_TITLE="VM(win11)" TRAY_ICON="$TRAY_ICON" TRAY_ICON_PAUSED="$TRAY_ICON_PAUSED" \
        python3 "$tray_py" > "$log_dir/tray.log" 2>&1 &
    tray_pid=$!
}

# ---------- 内存后端(virtiofs 需要 shared memory) ----------
memobj="memory-backend-memfd,id=mem0,size=$mem_size,share=on"
if grep -qi 'default_hugepagesz' /proc/cmdline && [[ -n ${HUGEPAGESZ:-} ]]; then
    memobj+=",hugetlb=on,hugetlbsize=$HUGEPAGESZ"   # 例: HUGEPAGESZ=2M ; 需预留 hugepages=N
fi

q=(
  -name win11,debug-threads=on -pidfile "$pidfile"
  -machine q35,accel=kvm,vmport=off,memory-backend=mem0
  -m "$mem_size" -object "$memobj"
  -rtc base=localtime
  -qmp "unix:$workingdir/qmp-shell.sock,server=on,wait=off"
  # 托盘专用 QMP(QMP socket 同时只接受一个客户端, 单独开一个避免和 qmp-shell 互相阻塞)
  -chardev "socket,id=qmptray,path=$workingdir/qmp-tray.sock,server=on,wait=off"
  -mon chardev=qmptray,mode=control
  -cpu host,migratable=off,hv-passthrough,host-cache-info=on,kvm=off
  -smp "$smp_args"
  # 网络
  -nic user,model=virtio-net-pci
  # USB
  -device qemu-xhci,id=xhci
  -device usb-tablet,bus=xhci.0
  # 音频
  -audiodev pipewire,id=audio0
  -device intel-hda -device hda-duplex,audiodev=audio0
  # virtio-serial (剪贴板)
  -device virtio-serial-pci,packed=on,ioeventfd=on
  -device virtserialport,name=com.redhat.spice.0,chardev=vdagent0
  # virtiofs
  -chardev socket,id=char0,path="$virtiofsd_sock_path"
  -device vhost-user-fs-pci,queue-size=1024,chardev=char0,tag=host-share
)

# ---------- 磁盘 ----------
disk_opts="format=qcow2,if=none,cache=none,aio=io_uring,discard=unmap,detect-zeroes=unmap,cache-clean-interval=900"
q+=(-drive "id=d0,file=$diskdir,$disk_opts" -drive "id=d1,file=$diskdata,$disk_opts")
if [[ $DISK_IF == virtio ]]; then
    q+=(-object iothread,id=io0
        -device virtio-blk-pci,drive=d0,iothread=io0,bootindex=1
        -device virtio-blk-pci,drive=d1,iothread=io0)
else
    q+=(-device ich9-ahci,id=ahci0
        -device ide-hd,drive=d0,bus=ahci0.0,bootindex=1
        -device ide-hd,drive=d1,bus=ahci0.1)
fi

# ---------- 显示 / 剪贴板 ----------
case $DISPLAY_MODE in
  lg)
    q+=(-vga none -display none
        -spice "unix=on,addr=$workingdir/spice.sock,disable-ticketing=on"
        -chardev spicevmc,id=vdagent0,name=vdagent
        -object "memory-backend-file,id=lgmem,mem-path=/dev/shm/looking-glass,size=$LG_SHM_SIZE,share=on"
        -device ivshmem-plain,memdev=lgmem) ;;
  none)
    q+=(-vga none -display none
        -chardev qemu-vdagent,id=vdagent0,name=vdagent,clipboard=on,mouse=off) ;;
  *)
    q+=(-vga virtio
        -display gtk,clipboard=on,zoom-to-fit=on,full-screen=off,gl=on,window-close=on,show-menubar=off
        -chardev qemu-vdagent,id=vdagent0,name=vdagent,clipboard=on,mouse=off) ;;
esac

# ---------- NVIDIA 直通(q35 下挂 PCIe root port, 同时直通音频功能) ----------
q+=(-device pcie-root-port,id=rp_gpu,chassis=1,slot=1
    -device vfio-pci,host=${GPU}.0,bus=rp_gpu,addr=00.0,multifunction=on)
[[ -e /sys/bus/pci/devices/${GPU}.1 ]] && \
    q+=(-device vfio-pci,host=${GPU}.1,bus=rp_gpu,addr=00.1)

q+=("$@")
echo "VM run as: qemu-system-x86_64 ${q[*]}"
[[ -n ${NOTIFY_SND:-} ]] && $cmd_notify "VM Start."

# ---------- 绑核(host_cpus_qemu / vcpu_map 见上方自动计算) ----------
taskset -c "$host_cpus_qemu" qemu-system-x86_64 "${q[@]}" > "$log_dir/qemu.log" 2>&1 &
qpid=$!
start_tray

# 等 vCPU 线程出现(线程名需要 debug-threads=on)
for i in $(seq 1 50); do
    n=$(grep -lE '^CPU [0-9]+/KVM$' /proc/$qpid/task/*/comm 2>/dev/null | wc -l)
    [[ $n -ge ${#vcpu_map[@]} ]] && break
    kill -0 "$qpid" 2>/dev/null || break
    sleep 0.2
done
for c in /proc/$qpid/task/*/comm; do
    [[ -r $c ]] || continue
    name=$(<"$c")
    if [[ $name =~ ^CPU\ ([0-9]+)/KVM$ ]]; then
        tid=$(basename "$(dirname "$c")")
        taskset -cp "${vcpu_map[${BASH_REMATCH[1]}]}" "$tid" > /dev/null
    fi
done

wait "$qpid"
rc=$?
rm -f "$pidfile"
echo "VM Quit with code($rc)."
