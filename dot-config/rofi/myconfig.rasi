configuration {
    show-icons: true;
    modes: "drun";
    ssh-command: "tmux-wrapper ssh {ssh-client} {host} [-p {port}]";
	dpi: 192;
    drun-use-desktop-cache: true;
    max-history-size: 128;
}
@theme "fullscreen-preview"

entry {
    placeholder: "输入搜索内容";
    placeholder-color: white;
}
listview {
    columns:       6;
}

element-icon {
    size: 8em;
}
element selected {
    border-color: rgb(129, 143, 180);
    background-color: rgb(129, 143, 180);
}

