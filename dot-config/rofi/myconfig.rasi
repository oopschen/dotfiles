configuration {
    modi: "window,run,ssh,combi";
    combi-modi: "drun,run";
    show-icons: true;
    ssh-command: "tmux-wrapper ssh {ssh-client} {host} [-p {port}]";
	dpi: 192;
    recursivebrowser {
      directory:         "~/Downloads";
      directories-first: true;
      command:           "xdg-open";
      show-hidden:       false;
      filter-regex:      "(.*cache.*|.*.o|.*.*)";
      sorting-method:    "mtime";
    }
}
@theme "my-fullscreen-preview"
